{
  "name": "hexagon-media-service",
  "version": "1.0.2",
  "private": true,
  "description": "Electron shell for Hexagon Media Service. The interface is web; the engine is Python.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.simplefox.hexagonmediaservice",
    "productName": "Hexagon Media Service",
    "directories": {
      "output": "../build-output"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SimpleFoxOfficial",
        "repo": "Hexagon-Media-Service"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist-engine",
        "to": "engine"
      },
      {
        "from": "../docs/Hexagon-Media-Service-Manual.pdf",
        "to": "Hexagon-Media-Service-Manual.pdf"
      },
      {
        "from": "../vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "../extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../mediadl/resources/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hexagon Media Service",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "../mediadl/resources/app.ico",
      "uninstallerIcon": "../mediadl/resources/app.ico",
      "installerHeaderIcon": "../mediadl/resources/app.ico",
      "license": "installer/LICENSE.txt",
      "include": "installer/installer.nsh",
      "artifactName": "Hexagon-Media-Service-${version}-Setup.${ext}",
      "uninstallDisplayName": "Hexagon Media Service ${version}"
    },
    "portable": {
      "artifactName": "Hexagon-Media-Service-${version}-Portable.${ext}"
    },
    "extraMetadata": {
      "description": "Hexagon Media Service - private downloader for YouTube, HDRezka, Reddit, Twitter and about 1800 other sites"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
